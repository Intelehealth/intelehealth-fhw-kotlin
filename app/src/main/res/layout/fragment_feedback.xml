<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        >

        <!-- Review Icon -->
        <ImageView
            android:id="@+id/reviewIcon"
            android:layout_width="@dimen/std_96dp"
            android:layout_height="@dimen/std_96dp"
            android:src="@drawable/review_icon"
            android:layout_marginTop="@dimen/std_16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Main Title -->
        <TextView
            android:id="@+id/headTxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/std_16dp"
            android:text="@string/title_rate_your_experience"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/reviewIcon"
            app:layout_constraintVertical_chainStyle="packed" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/subheadTxt"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/content_how_we_can_improve_experience"
            android:textColor="@color/textColorLightGary"
            android:textSize="@dimen/std_16sp"
            app:layout_constraintEnd_toEndOf="@id/headTxt"
            app:layout_constraintStart_toStartOf="@id/headTxt"
            app:layout_constraintTop_toBottomOf="@id/headTxt" />

        <!-- Rating Bar -->
        <RatingBar
            android:id="@+id/ratingBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:isIndicator="false"
            android:numStars="5"
            android:progressDrawable="@drawable/ratingbar"
            android:rating="0"
            android:layout_marginTop="@dimen/std_16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/subheadTxt" />

        <!-- Feedback Label -->
        <TextView
            android:id="@+id/giveFeedbackTxtView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lbl_give_feedback"
            style="@style/Theme.IDA.TextAppearance.Label"
            android:layout_marginStart="@dimen/std_16dp"
            android:layout_marginTop="@dimen/std_24dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ratingBar" />

        <!-- Feedback Input -->
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/editTextExitSurvey"
            android:layout_width="0dp"
            android:layout_height="@dimen/std_96dp"
            style="@style/Theme.IDA.OutlineInputBox"
            android:background="@drawable/bg_button_white_border"
            android:gravity="top"
            android:hint="@string/hint_type_here"
            android:paddingTop="@dimen/std_12dp"
            android:textSize="@dimen/std_16sp"
            android:layout_marginStart="@dimen/std_6dp"
            android:layout_marginTop="@dimen/std_8dp"
            android:layout_marginEnd="@dimen/std_16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/giveFeedbackTxtView" />

        <!-- Submit Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            style="@style/Theme.IDA.Button.Primary"
            android:padding="@dimen/std_12dp"
            android:text="@string/action_submit"
            android:layout_marginStart="@dimen/std_16dp"
            android:layout_marginEnd="@dimen/std_16dp"
            android:layout_marginBottom="@dimen/std_16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintWidth_percent="0.9" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>